{
  "name": "@2h2d/ts-config",
  "version": "0.0.1",
  "description": "Shared TypeScript compiler configuration for 2h2d repositories",
  "homepage": "https://github.com/2h2d-co/ts-config#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/ts-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@ozdokmeci.com",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/ts-config.git"
  },
  "files": [
    "base.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "check": "hk check --all --check",
    "pack:dry": "npm run build && npm pack --dry-run --ignore-scripts --allow-directory=all",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.0",
    "@types/node": "22.20.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
